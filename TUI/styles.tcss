/* CLI Media Scraper & Downloader - Modern Dark Cyberpunk TCSS */

Screen {
    background: #0d1117;
    color: #e6edf3;
}

Header {
    dock: top;
    height: 3;
    background: #161b22;
    color: #58a6ff;
    text-style: bold;
    border-bottom: heavy #30363d;
}

Footer {
    dock: bottom;
    height: 1;
    background: #161b22;
    color: #8b949e;
}

/* Tabs and Navigation */
TabbedContent {
    height: 1fr;
}

Tabs {
    background: #161b22;
    dock: top;
    border-bottom: solid #30363d;
}

Tab {
    padding: 0 2;
    color: #8b949e;
}

Tab.-active {
    color: #00e5ff;
    text-style: bold;
    border-bottom: tall #00e5ff;
}

TabPane {
    padding: 1;
    height: 1fr;
}

/* Search Tab Layout */
#search-controls {
    height: auto;
    padding: 1;
    background: #161b22;
    border: round #30363d;
    margin-bottom: 1;
}

.search-row {
    height: 3;
    align-vertical: middle;
    margin-bottom: 1;
}

#category-select, #provider-select {
    width: 28;
    margin-right: 1;
}

#search-input {
    width: 1fr;
    margin-right: 1;
    border: tall #30363d;
}

#search-input:focus {
    border: tall #00e5ff;
}

#btn-search {
    background: #238636;
    color: #ffffff;
    text-style: bold;
    min-width: 14;
}

#btn-search:hover {
    background: #2ea043;
}

/* Main Split View in Search */
#search-split-container {
    height: 1fr;
}

#results-pane {
    width: 56%;
    height: 1fr;
    background: #161b22;
    border: round #30363d;
    padding: 0 1;
    margin-right: 1;
}

#details-pane {
    width: 44%;
    height: 1fr;
    background: #161b22;
    border: round #30363d;
    padding: 1;
}

/* DataTable */
DataTable {
    height: 1fr;
    background: #161b22;
    border: none;
}

DataTable > .datatable--header {
    background: #21262d;
    color: #58a6ff;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #1f6feb;
    color: #ffffff;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: #21262d;
}

/* Details Card */
#details-header-row {
    height: auto;
    margin-bottom: 1;
    border-bottom: solid #30363d;
    padding-bottom: 1;
    align-vertical: middle;
}

#details-title {
    text-style: bold;
    color: #00e5ff;
    width: 1fr;
}

.category-badge {
    padding: 0 1;
    text-style: bold;
    border: round #30363d;
}

.badge-anime {
    background: #3b185f;
    color: #d8b4fe;
    border: round #a855f7;
}

.badge-movie {
    background: #1c2d42;
    color: #7dd3fc;
    border: round #0284c7;
}

.badge-tv {
    background: #064e3b;
    color: #6ee7b7;
    border: round #10b981;
}

.badge-nsfw {
    background: #4c0519;
    color: #fda4af;
    border: round #f43f5e;
}

#details-meta {
    height: auto;
    margin-bottom: 1;
    color: #c9d1d9;
}

#details-synopsis {
    height: 1fr;
    border: round #21262d;
    padding: 1;
    margin-bottom: 1;
    background: #0d1117;
    color: #8b949e;
    overflow-y: auto;
}

/* Context-Aware Dynamic Controls Container */
#dynamic-controls-box {
    height: auto;
    background: #0d1117;
    border: round #30363d;
    padding: 1;
    margin-bottom: 1;
}

.form-field-row {
    height: 3;
    align-vertical: middle;
    margin-bottom: 1;
}

.form-label {
    width: 20;
    color: #8b949e;
    text-style: bold;
}

.form-widget {
    width: 1fr;
}

.badge-full-movie {
    background: #1c2d42;
    color: #38bdf8;
    padding: 0 1;
    text-style: bold;
    border: round #0284c7;
}

.action-btn-row {
    height: 3;
    align-horizontal: right;
}

#btn-probe {
    background: #30363d;
    color: #00e5ff;
    text-style: bold;
    margin-right: 1;
}

#btn-probe:hover {
    background: #3b4252;
}

#btn-download {
    background: #1f6feb;
    color: #ffffff;
    text-style: bold;
    margin-right: 1;
}

#btn-download:hover {
    background: #388bfd;
}

#btn-dryrun {
    background: #8957e5;
    color: #ffffff;
    text-style: bold;
}

#btn-dryrun:hover {
    background: #a371f7;
}

/* History & Resume Tab */
#history-controls {
    height: 3;
    margin-bottom: 1;
    background: #161b22;
    border: round #30363d;
    padding: 0 1;
}

#history-table-container {
    height: 1fr;
    background: #161b22;
    border: round #30363d;
    padding: 0 1;
    margin-bottom: 1;
}

.history-btn-row {
    height: 3;
}

/* Settings Tab */
#settings-container {
    height: 1fr;
    background: #161b22;
    border: round #30363d;
    padding: 1 2;
    overflow-y: auto;
}

.settings-section-title {
    color: #58a6ff;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 1;
    border-bottom: solid #30363d;
    padding-bottom: 0;
}

.settings-row {
    height: 3;
    margin-bottom: 1;
    align-vertical: middle;
}

.settings-label {
    width: 25;
    color: #c9d1d9;
}

.settings-input {
    width: 1fr;
}

#btn-save-settings {
    background: #238636;
    color: #ffffff;
    text-style: bold;
    margin-top: 2;
    width: 24;
}

/* Status & Logs Widget */
#log-viewer {
    height: 1fr;
    background: #0d1117;
    border: round #30363d;
    padding: 1;
    color: #00f59b;
}

/* Loading Overlay / Status banner */
#status-banner {
    dock: bottom;
    height: 1;
    background: #21262d;
    color: #ffd166;
    padding-left: 1;
}
