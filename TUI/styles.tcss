/* ==========================================================================
   CLI MEDIA SCRAPER & DOWNLOADER - NEXT-GEN AWESOME-TUI THEME
   Obsidian Deep (#090d16), Slate (#0f172a), Hairline Guide (#1e293b)
   Accents: Anime (#c084fc), Movies (#38bdf8), TV (#34d399), NSFW (#fb7185), Amber (#f59e0b)
   ========================================================================== */

Screen {
    background: #090d16;
    color: #f1f5f9;
}

Header {
    dock: top;
    height: 3;
    background: #0f172a;
    color: #38bdf8;
    text-style: bold;
    border-bottom: solid #1e293b;
}

Footer {
    dock: bottom;
    height: 1;
    background: #0f172a;
    color: #94a3b8;
}

/* ==========================================================================
   Tabs Navigation (Slim & Minimalist)
   ========================================================================== */
TabbedContent {
    height: 1fr;
    background: #090d16;
}

Tabs {
    background: #0f172a;
    dock: top;
    border-bottom: solid #1e293b;
    height: 3;
}

Tab {
    padding: 0 2;
    color: #64748b;
    text-style: bold;
}

Tab:hover {
    color: #f1f5f9;
    background: #1e293b;
}

Tab.-active {
    color: #38bdf8;
    text-style: bold;
    border-bottom: tall #38bdf8;
    background: #1e293b;
}

TabPane {
    padding: 0;
    height: 1fr;
    background: #090d16;
}

/* ==========================================================================
   Search Top Command Bar (Flat, Seamless, Non-Boxy)
   ========================================================================== */
#search-controls {
    height: 4;
    padding: 0 1;
    background: #0f172a;
    border-bottom: solid #1e293b;
    margin-bottom: 0;
}

.search-row {
    height: 3;
    align-vertical: middle;
}

.cat-btn {
    min-width: 14;
    height: 3;
    margin-right: 1;
    background: #090d16;
    color: #64748b;
    text-style: bold;
    border: none;
}

.cat-btn:hover {
    background: #1e293b;
    color: #f1f5f9;
}

.cat-btn.-active-anime {
    background: #2e1065;
    color: #c084fc;
    border-bottom: tall #9333ea;
}

.cat-btn.-active-movies {
    background: #082f49;
    color: #38bdf8;
    border-bottom: tall #0284c7;
}

.cat-btn.-active-tv {
    background: #022c22;
    color: #34d399;
    border-bottom: tall #059669;
}

.cat-btn.-active-nsfw {
    background: #4c0519;
    color: #fb7185;
    border-bottom: tall #e11d48;
}

#provider-select {
    width: 22;
    margin-right: 1;
    background: #090d16;
    border: solid #1e293b;
    color: #f1f5f9;
}

#provider-select:focus {
    border: solid #38bdf8;
}

#search-input {
    width: 1fr;
    margin-right: 1;
    background: #090d16;
    border: solid #1e293b;
    color: #f1f5f9;
}

#search-input:focus {
    border: solid #38bdf8;
}

#btn-search {
    background: #059669;
    color: #ffffff;
    text-style: bold;
    min-width: 10;
    border: none;
}

#btn-search:hover {
    background: #10b981;
}

/* ==========================================================================
   Master-Detail Workspace Split (Borderless Flat Panes)
   ========================================================================== */
#search-split-container {
    height: 1fr;
    background: #090d16;
}

#results-pane {
    width: 50%;
    height: 1fr;
    background: #090d16;
    border-right: solid #1e293b;
    padding: 0 1;
}

#details-pane {
    width: 50%;
    height: 1fr;
    background: #090d16;
    padding: 0 1;
}

.pane-header-title {
    height: 2;
    padding: 0 1;
    color: #38bdf8;
    text-style: bold;
    background: #0f172a;
    border-bottom: solid #1e293b;
    margin-bottom: 0;
}

/* ==========================================================================
   DataTables (Results & Release Matrix)
   ========================================================================== */
DataTable {
    height: 1fr;
    background: #090d16;
    border: none;
    padding: 0;
}

DataTable > .datatable--header {
    background: #0f172a;
    color: #38bdf8;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #1e3a8a;
    color: #ffffff;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: #1e293b;
}

/* ==========================================================================
   Target Inspector Elements
   ========================================================================== */
#details-card-header {
    height: 2;
    background: #0f172a;
    padding: 0 1;
    color: #38bdf8;
    text-style: bold;
    border-bottom: solid #1e293b;
}

#details-meta {
    height: auto;
    padding: 1 1 0 1;
    color: #cbd5e1;
}

#details-synopsis {
    max-height: 4;
    padding: 0 1;
    color: #64748b;
    overflow-y: auto;
}

/* Inline Dynamic Controls Row */
#dynamic-controls-strip {
    height: 3;
    padding: 0 1;
    align-vertical: middle;
    background: #0f172a;
    border-top: solid #1e293b;
    border-bottom: solid #1e293b;
}

.inline-label {
    width: auto;
    margin-right: 1;
    color: #94a3b8;
    text-style: bold;
}

#audio-pref-select {
    width: 22;
    margin-right: 2;
    background: #090d16;
    border: solid #1e293b;
}

#episode-range-input {
    width: 16;
    background: #090d16;
    border: solid #1e293b;
}

.movie-badge-inline {
    background: #082f49;
    color: #38bdf8;
    padding: 0 1;
    text-style: bold;
    border: solid #0284c7;
}

/* Release Matrix Container */
#release-matrix-container {
    height: 1fr;
    background: #090d16;
}

#release-matrix-table {
    height: 1fr;
    background: #090d16;
}

/* Action Buttons Strip */
#action-buttons-strip {
    height: 3;
    padding: 0 1;
    align-vertical: middle;
    align-horizontal: right;
    background: #0f172a;
    border-top: solid #1e293b;
}

#btn-probe {
    background: #1e293b;
    color: #38bdf8;
    text-style: bold;
    margin-right: 1;
    min-width: 14;
    border: none;
}

#btn-probe:hover {
    background: #334155;
}

#btn-download {
    background: #0284c7;
    color: #ffffff;
    text-style: bold;
    margin-right: 1;
    min-width: 14;
    border: none;
}

#btn-download:hover {
    background: #0369a1;
}

#btn-dryrun {
    background: #7c3aed;
    color: #ffffff;
    text-style: bold;
    min-width: 12;
    border: none;
}

#btn-dryrun:hover {
    background: #6d28d9;
}

/* ==========================================================================
   Activity / Downloads Tab
   ========================================================================== */
#downloads-root {
    height: 1fr;
    padding: 1;
    background: #090d16;
}

#downloads-summary-panel {
    height: auto;
    background: #0f172a;
    border: solid #1e293b;
    padding: 1;
    margin-bottom: 1;
}

#downloads-metrics-row {
    height: 4;
    margin-bottom: 1;
}

.metric-card {
    background: #090d16;
    border: solid #1e293b;
    padding: 0 1;
    margin-right: 1;
    width: 1fr;
    height: 4;
}

.metric-label {
    color: #64748b;
    text-style: bold;
}

.metric-value {
    color: #38bdf8;
    text-style: bold;
}

#log-viewer {
    height: 1fr;
    background: #090d16;
    border: solid #1e293b;
    padding: 1;
    color: #34d399;
}

/* ==========================================================================
   History & Settings Tabs
   ========================================================================== */
#history-controls {
    height: 3;
    background: #0f172a;
    border-bottom: solid #1e293b;
    padding: 0 1;
    align-vertical: middle;
}

#history-table-container {
    height: 1fr;
    background: #090d16;
    padding: 0;
}

#settings-container {
    height: 1fr;
    background: #090d16;
    padding: 1 2;
    overflow-y: auto;
}

.settings-section-title {
    color: #38bdf8;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 1;
    border-bottom: solid #1e293b;
}

.settings-row {
    height: 3;
    margin-bottom: 1;
    align-vertical: middle;
}

.settings-label {
    width: 25;
    color: #cbd5e1;
}

.settings-input {
    width: 1fr;
}

#btn-save-settings {
    background: #059669;
    color: #ffffff;
    text-style: bold;
    margin-top: 2;
    width: 24;
    border: none;
}

#btn-save-settings:hover {
    background: #10b981;
}

#status-banner {
    dock: bottom;
    height: 1;
    background: #0f172a;
    color: #f59e0b;
    padding-left: 1;
    text-style: bold;
}

